#!/usr/bin/env node
/**
 * pi-async-rewake CLI — register, inspect, and cancel background jobs whose
 * completion should wake a Pi agent (like Claude Code's `asyncRewake: true`).
 *
 * The Pi extension (extension/index.ts) detects completed jobs and delivers
 * their output to the agent as a follow-up user message.
 */
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { spawnJob, listJobs, cancelJob, stateDir, isValidLabel } from "../lib/jobs.js";

const root = path.join(path.dirname(fileURLToPath(import.meta.url)), "..");
const pkg = JSON.parse(fs.readFileSync(path.join(root, "package.json"), "utf8"));

const USAGE = `pi-async-rewake ${pkg.version} — background job rewake for Pi

Usage:
  pi-async-rewake spawn [--label <name>] [--cwd <dir>] [--env KEY=VALUE ...] -- <command...>
  pi-async-rewake status [--json]
  pi-async-rewake cancel --label <name>

Commands:
  spawn    Run <command...> as a detached background job. The job's stdout and
           stderr are captured to the state directory; when it finishes, the Pi
           extension wakes the agent with the result.
  status   List all jobs and their state (running / done / stale).
  cancel   Kill a job (SIGTERM, then SIGKILL) and remove its state files.

Options:
  --label <name>    Job label (defaults to the basename of the command).
                    Labels match ${"[A-Za-z0-9][A-Za-z0-9._-]{0,63}"}.
  --cwd <dir>       Working directory for the job (default: current directory).
  --env K=V         Extra environment variable for the job (repeatable).
  --json            status: machine-readable output.
  -h, --help        Show this help.
  --version         Show the version.

Examples:
  pi-async-rewake spawn --label lavish -- lavish-axi poll /tmp/report.html
  pi-async-rewake spawn --label render --env FOO=bar -- bash -c 'sleep 5; echo done'
  pi-async-rewake status
  pi-async-rewake cancel --label lavish

State directory: ${stateDir()}  (override with PI_ASYNC_REWAKE_DIR)
`;

function die(message, code = 1) {
  console.error(`error: ${message}`);
  process.exit(code);
}

function parseSpawnArgs(argv) {
  const opts = { env: {} };
  const rest = [];
  let afterDash = false;
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (afterDash) {
      rest.push(a);
      continue;
    }
    if (a === "--") {
      afterDash = true;
    } else if (a === "--label") {
      opts.label = argv[++i];
      if (opts.label === undefined) die("--label requires a value");
    } else if (a === "--cwd") {
      opts.cwd = argv[++i];
      if (opts.cwd === undefined) die("--cwd requires a value");
    } else if (a === "--env") {
      const kv = argv[++i];
      if (kv === undefined || !kv.includes("=")) die("--env requires KEY=VALUE");
      const eq = kv.indexOf("=");
      opts.env[kv.slice(0, eq)] = kv.slice(eq + 1);
    } else if (a.startsWith("-") && a !== "-") {
      die(`unknown option ${a} (see --help)`);
    } else {
      rest.push(a);
    }
  }
  if (rest.length === 0) die("missing command (see --help)");
  opts.cmd = rest;
  if (!opts.label) opts.label = path.basename(rest[0]).replace(/[^A-Za-z0-9._-]/g, "_") || "job";
  return opts;
}

function fmtAge(iso) {
  if (!iso) return "-";
  const ms = Date.now() - new Date(iso).getTime();
  if (ms < 0) return "0s";
  if (ms < 10_000) return `${Math.round(ms / 100) / 10}s`;
  if (ms < 60_000) return `${Math.round(ms / 1000)}s`;
  if (ms < 3_600_000) return `${Math.floor(ms / 60_000)}m`;
  return `${Math.floor(ms / 3_600_000)}h`;
}

function fmtSize(bytes) {
  if (bytes <= 0) return "-";
  if (bytes < 1024) return `${bytes}B`;
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(1)}K`;
  return `${(bytes / (1024 * 1024)).toFixed(1)}M`;
}

function cmdSpawn(argv) {
  const { label, cmd, cwd, env } = parseSpawnArgs(argv);
  if (!isValidLabel(label)) {
    die(`invalid label ${JSON.stringify(label)} (must match [A-Za-z0-9][A-Za-z0-9._-]{0,63})`);
  }
  try {
    const job = spawnJob({ label, cmd, cwd: cwd ?? process.cwd(), env });
    console.log(
      `spawned job ${JSON.stringify(label)} (pid ${job.pid}) — detached, output in ${job.dir}`,
    );
    console.log(`the Pi agent will be woken with the result when it finishes`);
  } catch (err) {
    die(err.message);
  }
}

function cmdStatus(argv) {
  const json = argv.includes("--json");
  const jobs = listJobs();
  if (json) {
    console.log(JSON.stringify(jobs, null, 2));
    return;
  }
  if (jobs.length === 0) {
    console.log("no jobs — spawn one with: pi-async-rewake spawn --label <name> -- <command>");
    return;
  }
  const rows = jobs.map((j) => ({
    label: j.label,
    pid: j.pid ?? "-",
    state: j.state,
    exit: j.exitCode ?? (j.state === "running" ? "-" : "?"),
    age: fmtAge(j.startedAt),
    out: fmtSize(j.outSize),
    err: fmtSize(j.errSize),
  }));
  const w = (key) => Math.max(...rows.map((r) => String(r[key]).length), key.length);
  const pad = (s, width) => String(s).padEnd(width);
  const header = `  ${pad("LABEL", w("label"))} ${pad("PID", w("pid"))} ${pad("STATE", w("state"))} ${pad("EXIT", w("exit"))} ${pad("AGE", w("age"))} ${pad("OUT", w("out"))} ${pad("ERR", w("err"))}`;
  console.log(header);
  console.log("  " + "-".repeat(header.length - 2));
  for (const r of rows) {
    console.log(
      `  ${pad(r.label, w("label"))} ${pad(r.pid, w("pid"))} ${pad(r.state, w("state"))} ${pad(r.exit, w("exit"))} ${pad(r.age, w("age"))} ${pad(r.out, w("out"))} ${pad(r.err, w("err"))}`,
    );
  }
  console.log(`\nstate directory: ${stateDir()}`);
  const stale = rows.filter((r) => r.state === "stale").length;
  if (stale > 0) {
    console.log(`note: ${stale} stale job(s) — the process is gone without completing; cancel to clean up`);
  }
}

function cmdCancel(argv) {
  let label;
  for (let i = 0; i < argv.length; i++) {
    if (argv[i] === "--label") {
      label = argv[++i];
    } else if (!argv[i].startsWith("-")) {
      label = argv[i];
    }
  }
  if (!label) die("cancel requires --label <name>");
  return cancelJob(label)
    .then((res) => {
      if (res.terminated) {
        console.log(`canceled job ${JSON.stringify(label)} (pid ${res.pid ?? "-"})`);
      } else if (res.pid) {
        die(`could not terminate job ${JSON.stringify(label)} (pid ${res.pid})`);
      } else {
        console.log(`cleaned up job ${JSON.stringify(label)} (no live process)`);
      }
    })
    .catch((err) => die(err.message));
}

function main(argv) {
  const cmd = argv[0];
  const rest = argv.slice(1);
  switch (cmd) {
    case "spawn":
      return cmdSpawn(rest);
    case "status":
      return cmdStatus(rest);
    case "cancel":
      return cmdCancel(rest);
    case "-h":
    case "--help":
    case "help":
      console.log(USAGE);
      return;
    case "--version":
    case "version":
      console.log(pkg.version);
      return;
    default:
      if (cmd === undefined) {
        console.log(USAGE);
        return;
      }
      die(`unknown command ${JSON.stringify(cmd)} (see --help)`);
  }
}

void main(process.argv.slice(2));
