{
  "name": "@kakkoidev/pi-core",
  "version": "0.1.0",
  "description": "Pi extensions and tools: keep local models on track (local-model-guard), give them the coding habits of pi-local-harness (coding-boost), and wake the agent when background jobs finish (async-rewake). Merged into agentbox (2026-11-25); ai-core comes from agentbox's own dependencies.",
  "type": "module",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi-extension",
    "local-models",
    "ollama",
    "gemma",
    "qwen",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./local-model-guard/index.ts",
      "./coding-boost/index.ts",
      "./async-rewake/extension"
    ]
  },
  "bin": {
    "pi-async-rewake": "async-rewake/bin/pi-async-rewake"
  },
  "files": [
    "local-model-guard",
    "coding-boost",
    "verify",
    "async-rewake/bin",
    "async-rewake/lib",
    "async-rewake/extension",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'local-model-guard/test/*.test.mjs' 'coding-boost/test/*.test.mjs' 'async-rewake/test/*.test.js'"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  }
}
